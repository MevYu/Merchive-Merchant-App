    "dev:h5": "taro build --type h5 --watch",
    "dev:app": "taro build --type rn --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tarojs/components": "^4.0.0",
    "@tarojs/plugin-framework-react": "^4.0.0",
    "@tarojs/runtime": "^4.0.0",
    "@tarojs/taro": "^4.0.0",
    "i18next": "^23.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.0.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@tarojs/cli": "^4.0.0",
    "@tarojs/helper": "^4.2.0",
    "@tarojs/plugin-platform-h5": "^4.2.0",
    "@tarojs/plugin-platform-weapp": "^4.2.0",
    "@tarojs/react": "^4.2.0",
    "@tarojs/router": "^4.2.0",
    "@tarojs/shared": "^4.2.0",
    "@tarojs/webpack5-runner": "^4.0.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "babel-preset-taro": "^4.2.0",
    "typescript": "^5.3.0"
